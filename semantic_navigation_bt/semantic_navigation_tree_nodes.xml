<root BTCPP_format="4">
    <TreeNodesModel>
        <!-- ############################### ACTION NODES ################################# -->
        <Action ID="GenerateRandomGoals">
            <input_port name="service_name" default="generate_random_goals">Service name</input_port>
            <input_port name="number_of_goals" default="1">Number of goals</input_port>
            <input_port name="region_name">Region name</input_port>
            <input_port name="yaw">Yaw of the goals (Optional)</input_port>
            <input_port name="orientation">Random orientation of the goals</input_port>
            <input_port name="border" default="0.0">Distance from the edge of the region</input_port>
            <output_port name="goals">Generated goals</output_port>
        </Action>
        <Action ID="GetRandomRegion">
            <input_port name="service_name" default="get_random_region">Service name</input_port>
            <output_port name="region_name">Region name</output_port>
        </Action>
        <Action ID="GetRegionName">
            <input_port name="service_name" default="get_region_name">Service name</input_port>
            <input_port name="position">Position of the point</input_port>
            <output_port name="region_name">Region name</output_port>
        </Action>
        <Action ID="ListAllRegions">
            <input_port name="service_name" default="list_all_regions">Service name</input_port>
            <output_port name="region_names">Region names</output_port>
        </Action>
        <Action ID="GetAdjacentRegions">
            <input_port name="service_name" default="get_adjacent_regions">Service name</input_port>
            <input_port name="region_name">Region name</input_port>
            <output_port name="adjacent_regions">Adjacent regions</output_port>
        </Action>
        <Action ID="AreRegionsConnected">
            <input_port name="service_name" default="are_regions_connected">Service name</input_port>
            <input_port name="region_a">First region</input_port>
            <input_port name="region_b">Second region</input_port>
            <output_port name="connected">Whether both regions are connected</output_port>
        </Action>
        <Action ID="GetRegionRoute">
            <input_port name="service_name" default="get_region_route">Service name</input_port>
            <input_port name="start_region">Start region</input_port>
            <input_port name="goal_region">Goal region</input_port>
            <output_port name="route">Sequence of regions to traverse</output_port>
        </Action>
    </TreeNodesModel>
</root>

